{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "workbench": {
      "root": ".",
      "entrypoint": "server.mjs",
      "buildCommand": "npm run setup",
      "functions": {
        "server.mjs": {
          "includeFiles": "private/**",
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "workbench"
      }
    }
  ]
}
